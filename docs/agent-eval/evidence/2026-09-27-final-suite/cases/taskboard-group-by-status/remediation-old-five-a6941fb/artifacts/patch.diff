diff --git a/tests/test_group_tasks_by_status.py b/tests/test_group_tasks_by_status.py
index 9195e60..b585aa8 100644
--- a/tests/test_group_tasks_by_status.py
+++ b/tests/test_group_tasks_by_status.py
@@ -21,3 +21,56 @@ def test_groups_normalized_statuses_and_preserves_order():
         {"id": 4},
         {"id": 5, "status": None},
     ]
+
+
+def test_unknown_group_keeps_its_first_seen_position():
+    tasks = [
+        {"id": 1},
+        {"id": 2, "status": "Done"},
+        {"id": 3, "status": None},
+    ]
+
+    groups = group_tasks_by_status(tasks)
+
+    assert list(groups) == ["unknown", "done"]
+    assert [[task["id"] for task in rows] for rows in groups.values()] == [[1, 3], [2]]
+
+
+def test_blank_and_padded_statuses_are_normalized():
+    tasks = [
+        {"id": 1, "status": ""},
+        {"id": 2, "status": "   "},
+        {"id": 3, "status": "Open "},
+        {"id": 4, "status": "  OPEN"},
+    ]
+
+    groups = group_tasks_by_status(tasks)
+
+    assert list(groups) == ["unknown", "open"]
+    assert [[task["id"] for task in rows] for rows in groups.values()] == [[1, 2], [3, 4]]
+
+
+def test_group_keys_are_lowercase_and_values_are_lists():
+    groups = group_tasks_by_status([{"id": 1, "status": "In Review"}])
+
+    assert all(isinstance(key, str) and key == key.lower() for key in groups)
+    assert all(isinstance(rows, list) for rows in groups.values())
+
+
+def test_accepts_non_list_iterables_without_mutating_input():
+    tasks = (
+        {"id": 1, "status": "Open"},
+        {"id": 2, "status": "OPEN"},
+        {"id": 3},
+    )
+    original = tuple(dict(task) for task in tasks)
+
+    groups = group_tasks_by_status(task for task in tasks)
+
+    assert list(groups) == ["open", "unknown"]
+    assert [[task["id"] for task in rows] for rows in groups.values()] == [[1, 2], [3]]
+    assert tasks == original
+
+
+def test_empty_input_returns_empty_mapping():
+    assert group_tasks_by_status([]) == {}
