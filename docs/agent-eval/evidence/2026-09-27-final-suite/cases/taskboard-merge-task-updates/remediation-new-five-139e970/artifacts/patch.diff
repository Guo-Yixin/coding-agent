+def test_only_the_target_task_changes_and_the_order_is_preserved():
+    tasks = [
+        {"id": 1, "title": "First", "status": "open"},
+        {"id": 2, "title": "Second", "status": "open"},
+        {"id": 3, "title": "Third", "status": "open"},
+    ]
+    original = snapshot(tasks)
+
+    updated = merge_task_updates(tasks, 2, {"status": "done"})
+
+    assert [task["id"] for task in updated] == [1, 2, 3]
+    assert updated[0] == {"id": 1, "title": "First", "status": "open"}
+    assert updated[1] == {"id": 2, "title": "Second", "status": "done"}
+    assert updated[2] == {"id": 3, "title": "Third", "status": "open"}
+    assert tasks == original
+
+
+def test_result_list_and_target_task_are_new_objects():
+    tasks = [{"id": 1, "title": "First"}, {"id": 2, "title": "Second"}]
+
+    updated = merge_task_updates(tasks, 2, {"title": "Renamed"})
+
+    assert updated is not tasks
+    assert updated[1] is not tasks[1]
+    assert updated[0] is tasks[0]
+    assert tasks[1] == {"id": 2, "title": "Second"}
+
+
+def test_updates_without_id_keep_the_identifier():
+    tasks = [{"id": 7, "title": "Old", "status": "open"}]
+
+    updated = merge_task_updates(tasks, 7, {"title": "New"})
+
+    assert updated == [{"id": 7, "title": "New", "status": "open"}]
+    assert updated[0]["id"] == 7
+
+
+def test_updates_carrying_the_same_id_are_allowed():
+    tasks = [{"id": 5, "title": "Keep"}]
+
+    updated = merge_task_updates(tasks, 5, {"id": 5, "title": "Kept"})
+
+    assert updated == [{"id": 5, "title": "Kept"}]
+
+
+def test_identity_match_does_not_mutate_untouched_tasks():
+    tasks = [
+        {"id": 1, "title": "First"},
+        {"id": 2, "title": "Second"},
+        {"id": 3, "title": "Third"},
+    ]
+    original = snapshot(tasks)
+
+    updated = merge_task_updates(tasks, 1, {"title": "First updated"})
+
+    assert updated == [
+        {"id": 1, "title": "First updated"},
+        {"id": 2, "title": "Second"},
+        {"id": 3, "title": "Third"},
+    ]
+    assert tasks == original
+    assert all(task is original_task for task, original_task in zip(updated[1:], tasks[1:]))
+
+
+def test_duplicate_identifiers_update_the_first_match_only():
+    tasks = [{"id": 1, "title": "Old"}, {"id": 1, "title": "Also old"}]
+    original = snapshot(tasks)
+
+    updated = merge_task_updates(tasks, 1, {"title": "New"})
+
+    assert updated == [{"id": 1, "title": "New"}, {"id": 1, "title": "Also old"}]
+    assert tasks == original
+
+
+def test_tasks_without_an_id_are_never_matched():
+    tasks = [{"title": "No id"}, {"id": 2, "title": "Has id"}]
+
+    with pytest.raises(KeyError):
+        merge_task_updates(tasks, 1, {"title": "Missing"})
+
+    assert merge_task_updates(tasks, 2, {"title": "Updated"})[0] == {"title": "No id"}
+
+
+def test_missing_identifier_raises_key_error_and_keeps_input_intact():
+    tasks = [{"id": 1, "title": "First"}, {"id": 2, "title": "Second"}]
+    original = snapshot(tasks)
+
+    with pytest.raises(KeyError):
+        merge_task_updates(tasks, 3, {"title": "Nope"})
+
+    assert tasks == original
+
+
+def test_iterable_inputs_are_supported():
+    updated = merge_task_updates(iter([{"id": 1, "title": "Old"}]), 1, {"title": "New"})
+
+    assert updated == [{"id": 1, "title": "New"}]
