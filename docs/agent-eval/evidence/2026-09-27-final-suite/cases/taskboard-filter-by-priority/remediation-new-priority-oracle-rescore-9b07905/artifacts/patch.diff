+PRIORITY_ALIASES = {"urgent": "high", "backlog": "low"}
+UNKNOWN_PRIORITY = "unknown"
+
+
+def _normalize_priority(value: object) -> str:
+    """Map a raw priority value to its canonical, case-insensitive form."""
+
+    text = "" if value is None else str(value).strip().lower()
+    if not text:
+        return UNKNOWN_PRIORITY
+    return PRIORITY_ALIASES.get(text, text)
+
+
 def search_tasks(tasks: Iterable[Task], query: str) -> list[Task]:
     """Find tasks whose title contains query, preserving input order."""
 
@@ -30,3 +43,19 @@ def sort_by_priority(tasks: Iterable[Task]) -> list[Task]:
 
     order = {"high": 0, "medium": 1, "low": 2}
     return sorted(tasks, key=lambda task: order.get(str(task.get("priority", "")).lower(), 99))
+
+
+def filter_by_priority(
+    tasks: Iterable[Task], priorities: str | Iterable[str] | None = None
+) -> list[Task]:
+    """Return tasks matching normalized priorities; no filter returns every task."""
+
+    rows = list(tasks)
+    if priorities is None:
+        return rows
+
+    if isinstance(priorities, str):
+        wanted = {_normalize_priority(priorities)}
+    else:
+        wanted = {_normalize_priority(priority) for priority in priorities}
+    return [task for task in rows if _normalize_priority(task.get("priority")) in wanted]
diff --git a/tests/test_filter_by_priority.py b/tests/test_filter_by_priority.py
index 369e7e4..72ce945 100644
--- a/tests/test_filter_by_priority.py
+++ b/tests/test_filter_by_priority.py
@@ -18,3 +18,57 @@ def test_none_returns_all_and_unknown_matches_missing_priority_without_mutating_
     assert filter_by_priority(tasks) == tasks
     assert [task["id"] for task in filter_by_priority(tasks, "unknown")] == [1, 2]
     assert tasks == snapshot
+
+
+def test_priority_aliases_work_in_both_directions():
+    tasks = [
+        {"id": 1, "priority": "urgent"},
+        {"id": 2, "priority": "high"},
+        {"id": 3, "priority": "backlog"},
+        {"id": 4, "priority": "low"},
+    ]
+    assert [task["id"] for task in filter_by_priority(tasks, "high")] == [1, 2]
+    assert [task["id"] for task in filter_by_priority(tasks, "urgent")] == [1, 2]
+    assert [task["id"] for task in filter_by_priority(tasks, "low")] == [3, 4]
+    assert [task["id"] for task in filter_by_priority(tasks, "backlog")] == [3, 4]
+
+
+def test_filter_accepts_sets_tuples_and_generators_keeping_task_order():
+    tasks = [
+        {"id": 1, "priority": "medium"},
+        {"id": 2, "priority": "Urgent"},
+        {"id": 3, "priority": "LOW"},
+        {"id": 4, "priority": "high"},
+    ]
+    snapshot = [dict(task) for task in tasks]
+
+    assert [task["id"] for task in filter_by_priority(tasks, {"HIGH", "Urgent", "MEDIUM"})] == [
+        1,
+        2,
+        4,
+    ]
+    assert [task["id"] for task in filter_by_priority(tasks, ("backlog", "medium"))] == [1, 3]
+    assert [task["id"] for task in filter_by_priority(tasks, (p for p in ["low"]))] == [3]
+    assert isinstance(filter_by_priority(tasks, "high"), list)
+    assert tasks == snapshot
+
+
+def test_blank_priority_counts_as_unknown():
+    tasks = [
+        {"id": 1, "priority": "   "},
+        {"id": 2, "priority": ""},
+        {"id": 3, "priority": "unknown"},
+        {"id": 4, "priority": "low"},
+    ]
+    assert [task["id"] for task in filter_by_priority(tasks, "unknown")] == [1, 2, 3]
+
+
+def test_unmatched_priority_returns_empty_list():
+    tasks = [{"id": 1, "priority": "high"}, {"id": 2, "priority": None}]
+    assert filter_by_priority(tasks, "critical") == []
+
+
+def test_single_string_argument_is_not_split_into_characters():
+    tasks = [{"id": 1, "priority": "high"}, {"id": 2, "priority": "medium"}]
+    assert [task["id"] for task in filter_by_priority(tasks, "high")] == [1]
+    assert filter_by_priority(tasks, "h") == []
