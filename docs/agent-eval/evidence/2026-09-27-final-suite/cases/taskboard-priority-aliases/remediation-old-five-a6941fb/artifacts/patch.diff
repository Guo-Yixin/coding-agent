@@ -25,8 +25,26 @@ def search_tasks(tasks: Iterable[Task], query: str) -> list[Task]:
     return [task for task in rows if query in str(task.get("title", ""))]
 
 
+_PRIORITY_RANKS = {"high": 0, "medium": 1, "low": 2}
+_PRIORITY_ALIASES = {"urgent": "high", "backlog": "low"}
+_UNKNOWN_PRIORITY = 99
+
+
+def _priority_rank(task: Task) -> int:
+    """Map a task priority to its rank, aliases and case insensitive."""
+
+    raw = task.get("priority")
+    key = str(raw).strip().lower() if raw is not None else ""
+    key = _PRIORITY_ALIASES.get(key, key)
+    return _PRIORITY_RANKS.get(key, _UNKNOWN_PRIORITY)
+
+
 def sort_by_priority(tasks: Iterable[Task]) -> list[Task]:
-    """Return tasks ordered by priority while preserving equal-priority order."""
+    """Return tasks ordered by priority while preserving equal-priority order.
+
+    Priorities are compared case insensitively, ``urgent`` ranks as ``high``
+    and ``backlog`` ranks as ``low``. Missing or unknown priorities are stable
+    among themselves and sorted after every known priority.
+    """
 
-    order = {"high": 0, "medium": 1, "low": 2}
-    return sorted(tasks, key=lambda task: order.get(str(task.get("priority", "")).lower(), 99))
+    return sorted(tasks, key=_priority_rank)
