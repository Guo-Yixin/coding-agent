+        {"id": 3, "priority": "urgent"},
+        {"id": 4, "priority": "high"},
+        {"id": 5, "priority": "low"},
+    ]
+    expected = [3, 4, 2, 1, 5]
+    assert [task["id"] for task in sort_by_priority(mixed_case)] == expected
+    assert [task["id"] for task in sort_by_priority(lowercase)] == expected
+
