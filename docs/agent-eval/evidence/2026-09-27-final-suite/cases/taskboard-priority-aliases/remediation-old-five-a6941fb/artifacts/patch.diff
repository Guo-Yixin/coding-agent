 from taskboard.tasks import sort_by_priority
 
 
+def test_priority_sort_treats_urgent_as_high_and_backlog_as_low():
+    tasks = [
+        {"id": 1, "priority": "backlog"},
+        {"id": 2, "priority": "medium"},
+        {"id": 3, "priority": "urgent"},
+        {"id": 4, "priority": "high"},
+        {"id": 5, "priority": "low"},
+    ]
+    assert [task["id"] for task in sort_by_priority(tasks)] == [3, 4, 2, 1, 5]
