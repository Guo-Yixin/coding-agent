 def test_pagination_rejects_non_positive_or_non_integer_arguments(page, page_size):
     with pytest.raises(ValueError):
         paginate_tasks([], page=page, page_size=page_size)
+
+
+def test_pagination_requires_keyword_arguments():
+    tasks = [{"id": 1}, {"id": 2}]
+    with pytest.raises(TypeError):
+        paginate_tasks(tasks, 1, 2)
+
+
+def test_page_size_larger_than_input_returns_everything_on_first_page():
+    assert paginate_tasks([{"id": 1}, {"id": 2}], page=1, page_size=10) == [{"id": 1}, {"id": 2}]
+
+
+def test_walking_every_page_reproduces_the_input_in_order():
+    tasks = [{"id": index} for index in range(1, 8)]
+    collected = []
+    page = 1
+    while True:
+        chunk = paginate_tasks(tasks, page=page, page_size=2)
+        if not chunk:
+            break
+        collected.extend(chunk)
+        page += 1
+    assert collected == tasks
+
+
+def test_last_page_boundary_and_pages_far_past_the_end_are_empty():
+    tasks = [{"id": index} for index in range(1, 5)]
+    assert paginate_tasks(tasks, page=2, page_size=2) == [{"id": 3}, {"id": 4}]
+    assert paginate_tasks(tasks, page=3, page_size=2) == []
+    assert paginate_tasks(tasks, page=9999, page_size=2) == []
+
+
+def test_empty_input_with_valid_arguments_returns_empty_list():
+    assert paginate_tasks([], page=1, page_size=3) == []
+    assert paginate_tasks([], page=5, page_size=3) == []
+
+
+def test_pagination_accepts_one_shot_iterables_without_re_consuming_them():
+    tasks = [{"id": index} for index in range(1, 6)]
+    assert paginate_tasks(iter(tasks), page=2, page_size=2) == tasks[2:4]
+    assert paginate_tasks((task for task in tasks), page=1, page_size=2) == tasks[0:2]
+    assert paginate_tasks(map(lambda task: dict(task), tasks), page=3, page_size=2) == tasks[4:6]
+    assert paginate_tasks(filter(None, tasks), page=1, page_size=100) == tasks
+
+
+def test_pagination_does_not_mutate_or_copy_the_input():
+    first = {"id": 1}
+    second = {"id": 2}
+    third = {"id": 3}
+    fourth = {"id": 4}
+    tasks = [first, second, third, fourth]
+    snapshot = [dict(task) for task in tasks]
+
+    page = paginate_tasks(tasks, page=2, page_size=2)
+
+    assert tasks == snapshot
+    assert len(tasks) == len(snapshot)
+    assert len(page) == 2
+    assert page[0] is third
+    assert page[1] is fourth
+
+
+def test_pagination_handles_large_offsets_without_error():
+    tasks = [{"id": index} for index in range(1, 11)]
+    assert paginate_tasks(tasks, page=100_000, page_size=1) == []
+    assert paginate_tasks(tasks, page=10, page_size=1) == [{"id": 10}]
