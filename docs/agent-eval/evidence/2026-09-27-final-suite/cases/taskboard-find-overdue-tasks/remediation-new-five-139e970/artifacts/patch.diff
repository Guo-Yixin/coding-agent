@@ -1,11 +1,14 @@
 from __future__ import annotations
 
 from collections.abc import Iterable
+from datetime import date, datetime
 from typing import Any
 
 
 Task = dict[str, Any]
 
+FINISHED_STATUSES = frozenset({"done", "completed", "cancelled"})
+
 
 def filter_by_status(tasks: Iterable[Task], status: str | None = None) -> list[Task]:
     """Return tasks matching status; no filter returns every task."""
@@ -30,3 +33,47 @@ def sort_by_priority(tasks: Iterable[Task]) -> list[Task]:
 
     order = {"high": 0, "medium": 1, "low": 2}
     return sorted(tasks, key=lambda task: order.get(str(task.get("priority", "")).lower(), 99))
+
+
+def _as_date(value: Any) -> date | None:
+    """Coerce a date, datetime or ISO date string into a date; None when unsupported."""
+
+    if isinstance(value, datetime):
+        return value.date()
+    if isinstance(value, date):
+        return value
+    if isinstance(value, str):
+        try:
+            return date.fromisoformat(value.strip())
+        except ValueError:
+            return None
+    return None
+
+
+def _coerce_today(today: Any) -> date:
+    """Return today as a date, raising ValueError when it cannot be parsed."""
+
+    if isinstance(today, datetime):
+        return today.date()
+    if isinstance(today, date):
+        return today
+    if isinstance(today, str):
+        try:
+            return date.fromisoformat(today.strip())
+        except ValueError as error:
+            raise ValueError(f"today is not a valid ISO date: {today!r}") from error
+    raise ValueError(f"today must be a date or ISO date string: {type(today).__name__}")
+
+
+def find_overdue_tasks(tasks: Iterable[Task], *, today: date | str) -> list[Task]:
+    """Return unfinished tasks whose due_date is strictly before today, in input order."""
+
+    rows = list(tasks)
+    cutoff = _coerce_today(today)
+    return [
+        task
+        for task in rows
+        if (due := _as_date(task.get("due_date"))) is not None
+        and due < cutoff
+        and str(task.get("status", "")).strip().lower() not in FINISHED_STATUSES
+    ]
