@@ -1,4 +1,6 @@
-from datetime import date
+from datetime import date, datetime
+
+import pytest
 
 from taskboard import find_overdue_tasks
 
@@ -16,3 +18,73 @@ def test_returns_only_unfinished_tasks_strictly_before_today_in_input_order():
 def test_ignores_missing_or_invalid_due_dates_and_accepts_iso_today():
     tasks = [{"id": 1}, {"id": 2, "due_date": "not-a-date"}, {"id": 3, "due_date": "2024-01-01"}]
     assert [task["id"] for task in find_overdue_tasks(tasks, today="2024-02-01")] == [3]
+
+
+def test_due_today_or_in_the_future_is_not_overdue():
+    tasks = [
+        {"id": 1, "due_date": "2025-01-01", "status": "open"},
+        {"id": 2, "due_date": "2025-01-02", "status": "open"},
+        {"id": 3, "due_date": "2025-01-03", "status": "open"},
+    ]
+    assert [task["id"] for task in find_overdue_tasks(tasks, today=date(2025, 1, 2))] == [1]
+
+
+def test_finished_statuses_are_excluded_regardless_of_case_and_padding():
+    tasks = [
+        {"id": 1, "due_date": "2024-01-01", "status": "open"},
+        {"id": 2, "due_date": "2024-01-01", "status": "done"},
+        {"id": 3, "due_date": "2024-01-01", "status": "Done"},
+        {"id": 4, "due_date": "2024-01-01", "status": "completed"},
+        {"id": 5, "due_date": "2024-01-01", "status": "Completed"},
+        {"id": 6, "due_date": "2024-01-01", "status": "cancelled"},
+        {"id": 7, "due_date": "2024-01-01", "status": "  Cancelled  "},
+    ]
+    assert [task["id"] for task in find_overdue_tasks(tasks, today=date(2024, 6, 1))] == [1]
+
+
+def test_tasks_without_status_still_count_as_unfinished():
+    tasks = [
+        {"id": 1, "due_date": "2024-01-01"},
+        {"id": 2, "due_date": "2024-01-01", "status": None},
+        {"id": 3, "due_date": "2024-01-01", "status": ""},
+    ]
+    assert [task["id"] for task in find_overdue_tasks(tasks, today=date(2024, 6, 1))] == [1, 2, 3]
+
+
+def test_today_accepts_date_and_equivalent_iso_string():
+    tasks = [{"id": 1, "due_date": "2024-12-31", "status": "open"}]
+    as_date = find_overdue_tasks(tasks, today=date(2025, 1, 1))
+    as_iso = find_overdue_tasks(tasks, today="2025-01-01")
+    assert as_date == as_iso == [tasks[0]]
+
+
+def test_datetime_today_uses_its_date_part():
+    tasks = [{"id": 1, "due_date": "2024-01-01", "status": "open"}]
+    assert find_overdue_tasks(tasks, today=datetime(2024, 6, 1, 12, 30)) == [tasks[0]]
+
+
+@pytest.mark.parametrize("today", ["2024-13-45", "not-a-date", "", "2024/01/02", 20240101, None])
+def test_unparsable_today_raises_value_error(today):
+    with pytest.raises(ValueError):
+        find_overdue_tasks([{"id": 1, "due_date": "2024-01-01"}], today=today)
+
+
+def test_result_keeps_original_objects_and_does_not_mutate_input():
+    tasks = [
+        {"id": 1, "due_date": "2024-01-01", "status": "open"},
+        {"id": 2, "due_date": "2024-01-01", "status": "done"},
+        {"id": 3, "due_date": "2023-05-05", "status": "open"},
+    ]
+    original = [dict(task) for task in tasks]
+
+    result = find_overdue_tasks(tasks, today="2024-06-01")
+
+    assert [task["id"] for task in result] == [1, 3]
+    assert result[0] is tasks[0]
+    assert result[1] is tasks[2]
+    assert tasks == original
+
+
+def test_returns_empty_list_when_nothing_is_overdue():
+    tasks = [{"id": 1, "due_date": "2025-01-01", "status": "open"}]
+    assert find_overdue_tasks(tasks, today=date(2024, 1, 1)) == []
