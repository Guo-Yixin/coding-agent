-    """Find tasks whose title contains query, preserving input order."""
+    """Find tasks whose title contains query, ignoring case and preserving order.
+
+    An empty query returns every task untouched. Tasks without a usable
+    string title are skipped instead of raising or matching by accident.
+    """
 
     rows = list(tasks)
     if not query:
         return rows
-    return [task for task in rows if query in str(task.get("title", ""))]
+
+    needle = query.casefold()
+    matches: list[Task] = []
+    for task in rows:
+        title = task.get("title")
+        if not isinstance(title, str):
+            continue
+        if needle in title.casefold():
+            matches.append(task)
+    return matches
 
 
