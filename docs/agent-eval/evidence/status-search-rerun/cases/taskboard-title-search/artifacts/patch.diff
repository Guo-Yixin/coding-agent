+def test_none_title_is_neither_matched_nor_error():
+    tasks = [
+        {"id": 1, "title": None},
+        {"id": 2, "title": "None shall pass"},
+    ]
+    assert [task["id"] for task in search_tasks(tasks, "none")] == [2]
+    assert search_tasks(tasks, "na") == []
+
+
+def test_non_string_title_is_stringified_before_matching():
+    tasks = [
+        {"id": 1, "title": 123},
+        {"id": 2, "title": "task 999"},
+    ]
+    assert [task["id"] for task in search_tasks(tasks, "12")] == [1]
+
+
+def test_empty_query_returns_every_task_without_mutating_input():
+    tasks = [
+        {"id": 1, "title": "Fix API timeout"},
+        {"id": 2},
+        {"id": 3, "title": None},
+    ]
+    original = [dict(task) for task in tasks]
+
+    assert search_tasks(tasks, "") == tasks
+    assert [task["id"] for task in search_tasks(iter(tasks), "")] == [1, 2, 3]
+    assert tasks == original
+
+
+def test_search_preserves_relative_order_of_scattered_matches():
+    tasks = [
+        {"id": 1, "title": "Fix API timeout"},
+        {"id": 2, "title": "Clean UI"},
+        {"id": 3},
+        {"id": 4, "title": "Review api contract"},
+        {"id": 5, "title": "Write docs"},
+        {"id": 6, "title": "API docs polish"},
+    ]
+    assert [task["id"] for task in search_tasks(tasks, "ApI")] == [1, 4, 6]
+
