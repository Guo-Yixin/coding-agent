# CODING local configuration template. Replace placeholders locally; never commit real secrets.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-flash

GITEE_TOKEN=your-gitee-token
GITEE_API_BASE_URL=https://gitee.com/api/v5
GITEE_WEB_BASE_URL=https://gitee.com
DEFAULT_REPO_PROVIDER=gitee

# Project-local data and logs. Relative paths keep the actual checkout portable.
CODING_DATA_DIR=./data
CODING_LOG_DIR=./logs
CODING_LOG_LEVEL=INFO
CODING_LOG_WHEN=midnight
CODING_LOG_INTERVAL=1
CODING_LOG_RETENTION_DAYS=14
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
STORE_DB_PATH=./data/store.sqlite
LANGGRAPH_STORE_DB_PATH=./data/langgraph_store.sqlite

AI_WORKSPACE_ROOT=B:\ai_workspace

LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=

DASHBOARD_BASE_URL=http://127.0.0.1:2024
DASHBOARD_API_BASE_URL=http://127.0.0.1:2024
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:3000
DASHBOARD_DEV_LOGIN=coding
DASHBOARD_DEV_EMAIL=developer@example.com
CONFIGURED_ADMINS=developer@example.com
DASHBOARD_JWT_SECRET=change-me

SANDBOX_TYPE=local
LOCAL_SHELL_WORKSPACE=
LOCAL_SHELL_PROJECTS_DIR=projects
LOCAL_SHELL_SHARED_PYTHON_VENV=
LOCAL_SHELL_ENABLE_COMMAND_GUARD=true
LOCAL_SHELL_ALLOW_NETWORK=false

AGENT_MAX_TOOL_CALLS=100
AGENT_MAX_SECONDS=1800
AGENT_CODING_MAX_TOOL_CALLS=100
AGENT_CODING_MAX_SECONDS=1800

# PostgreSQL example; keep the real DSN in the untracked .env file.
POSTGRES_DSN=postgresql://postgres:<password>@<postgresql-ip>:5432/coding_agent_db
